# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: real keys never leave the laptop or the Vercel dashboard.
# Only the placeholder file is committed.
.env
.env*.local
.env*
!.env.example

# vercel
.vercel

# playwright
/test-results/
/playwright-report/

# Local files of coding tools and editors: never part of the project.
# (next dev writes AGENTS.md by itself.)
.claude/
CLAUDE.md
AGENTS.md

# typescript
*.tsbuildinfo
next-env.d.ts

# iCloud Drive (Desktop & Documents sync) writes "file 2.ext", "file 3.ext"… copies
# when build output changes quickly. They are never real project files.
* [0-9].*

# Generated voice clips (npm run voice:clips). Remove this line to commit them.
public/voice/

# Output of the audit, visual comparison and demo snapshot scripts:
# screenshots, manifests and reports are made on demand, not committed.
e2e/__*__/
e2e/visual-*.json
docs/audits/
test-results/
playwright-report/
