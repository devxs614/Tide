# Server-side only. Never expose to the client. Never commit real values.
ANTHROPIC_API_KEY=your-key-here

# Model identifiers (keep configurable)
TIDE_MODEL_FAST=claude-haiku-5-5
TIDE_MODEL_SMART=claude-sonnet-5-5

# Request timeouts in milliseconds
TIDE_AI_TIMEOUT_MS=8000
TIDE_AI_DEMO_TIMEOUT_MS=4000

# Simple per-IP rate limit for the public deployment
TIDE_RATE_LIMIT_MAX=40
TIDE_RATE_LIMIT_WINDOW_MS=600000

# Optional natural voices for read-aloud (v2). Keep TIDE_TTS_PROVIDER=none to
# use the device's own voices. Only the text someone asks to hear is sent.
# Provider: none, openai or elevenlabs. Fill in only the key for the one you pick.
TIDE_TTS_PROVIDER=none
OPENAI_API_KEY=
TIDE_TTS_OPENAI_MODEL=gpt-4o-mini-tts
ELEVENLABS_API_KEY=
TIDE_TTS_ELEVEN_MODEL=eleven_multilingual_v2
TIDE_TTS_MAX_CHARS=600
